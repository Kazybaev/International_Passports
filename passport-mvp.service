[Unit]
Description=Passport Lens Streamlit MVP
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/zhanysh/EO/passport
ExecStart=/home/zhanysh/EO/passport/.venv/bin/streamlit run app.py --server.headless=true --server.address=0.0.0.0 --server.port=8501
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=LLAMA_CPP_BINARY=/home/zhanysh/EO/passport/artifacts/llama.cpp/llama-b10333/llama-server
Environment=MPLCONFIGDIR=/home/zhanysh/EO/passport/artifacts/matplotlib

[Install]
WantedBy=default.target
